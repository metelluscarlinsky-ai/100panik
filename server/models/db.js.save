,

      stmt.run(p[0], p[1], p[2], p[3], p[4], p[5], JSON.stringify(p[6]), JSON.stringify(p[7]), p[8], p[9]);
    });
  }

  // Settings default
  const sett = db.prepare('SELECT COUNT(*) as c FROM settings').get().c;
  if (sett === 0) {
    const defaults = {
      brand_name: '100PANIK',
      tagline: 'Rad pou moun ki pa janm kanpe.',
      contact_email: 'kontak@100panik.com',
      contact_phone: '+509 0000-0000',
      instagram: 'https://instagram.com/100panik',
      facebook: '',
      tiktok: '',
      primary_color: '#00f0ff',
      accent_color: '#ff0040'
    };
    const stmt = db.prepare('INSERT INTO settings (key, value) VALUES (?, ?)');
    Object.entries(defaults).forEach(([k, v]) => stmt.run(k, v));
  }
}
seed();

module.exports = db;

